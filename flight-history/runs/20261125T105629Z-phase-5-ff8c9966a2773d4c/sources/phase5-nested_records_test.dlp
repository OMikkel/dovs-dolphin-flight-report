record Point {
    x: int;
    y: int;
}

record Rectangle {
    top_left: Point;
    bottom_right: Point;
}

int main() {
    var r: Rectangle = new Rectangle {
        top_left = new Point { x = 10; y = 20; };
        bottom_right = new Point { x = 30; y = 40; };
    };

    return r.top_left.x + r.bottom_right.y;
}